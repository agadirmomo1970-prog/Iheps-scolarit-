# =============================================================================
# IHEPS AGADIR — Scolarité · configuration d'environnement
# Copiez ce fichier en « .env » puis adaptez les valeurs.
# =============================================================================

# Clé secrète Flask (obligatoire). Générez-la avec :
#   python -c "import secrets; print(secrets.token_hex(32))"
# L'application refuse de démarrer si cette valeur est vide, trop courte ou
# égale à une valeur d'exemple publiée.
SECRET_KEY=

# Base de données.
# En local, laissez vide pour utiliser SQLite (instance/iheps.db).
# En production, utilisez PostgreSQL :
# DATABASE_URL=postgresql+psycopg://utilisateur:motdepasse@hote:5432/iheps
DATABASE_URL=

# Cookies sécurisés : mettez 1 uniquement si le site est servi en HTTPS.
SESSION_COOKIE_SECURE=0

# Compte administrateur créé par « flask --app wsgi init-db » ou « python seed.py ».
# Aucun mot de passe par défaut n'est codé en dur :
# - en production, ADMIN_PASSWORD est obligatoire ;
# - en local, s'il est vide, un mot de passe aléatoire est généré et affiché ;
# - le changement de mot de passe est imposé à la première connexion.
ADMIN_USERNAME=responsable
ADMIN_PASSWORD=

# Développement uniquement.
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
